{
  "name": "gto-poker-trainer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "predev": "node scripts/check-layout.mjs && node scripts/predev.mjs",
    "dev": "next dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "next build --webpack",
    "start": "next start",
    "knowledge:publish": "node --import tsx scripts/publish-knowledge.ts",
    "knowledge:activate": "node --import tsx scripts/activate-knowledge.ts",
    "knowledge:init": "node --import tsx scripts/init-knowledge.ts",
    "check:layout": "node scripts/check-layout.mjs",
    "prebuild": "node scripts/check-layout.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tailwindcss": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "latest",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
